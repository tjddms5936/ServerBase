{
  "schema_version": 1,
  "dataset": {
    "name": "UNSW-NB15",
    "training_file": "data/raw/unsw_nb15/UNSW_NB15_training-set.csv"
  },
  "split": {
    "n_splits": 5,
    "validation_fold": 0,
    "random_state": 42,
    "stratify_column": "attack_cat",
    "grouping": "normalized_input_feature_fingerprint"
  },
  "thresholds": [0.3, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9],
  "selection": {
    "max_false_positive_rate": 0.1,
    "primary_metric": "recall",
    "tie_breakers": ["f1_desc", "false_positive_rate_asc", "candidate_id_asc", "threshold_asc"]
  },
  "random_forest_common_parameters": {
    "n_estimators": 100,
    "criterion": "gini",
    "max_depth": null,
    "min_samples_split": 2,
    "max_features": "sqrt",
    "bootstrap": true,
    "class_weight": null,
    "random_state": 42,
    "n_jobs": 4
  },
  "candidates": [
    {
      "id": "logistic_regression_c1",
      "kind": "logistic_regression",
      "parameters": {"C": 1.0, "max_iter": 1000, "solver": "lbfgs", "class_weight": null, "random_state": 42}
    },
    {
      "id": "random_forest_leaf1",
      "kind": "random_forest",
      "parameters": {"min_samples_leaf": 1}
    },
    {
      "id": "random_forest_leaf5",
      "kind": "random_forest",
      "parameters": {"min_samples_leaf": 5}
    },
    {
      "id": "random_forest_leaf20",
      "kind": "random_forest",
      "parameters": {"min_samples_leaf": 20}
    }
  ]
}
