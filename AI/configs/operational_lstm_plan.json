  "preprocessing": {
    "kind": "StandardScaler",
    "fit_scope": "unique_original_train_rows_only",
    "transform_scope": "valid_steps_only_then_zero_pad",
    "tensor_dtype": "float32",
    "missing_value_policy": "reject_without_zero_fill"
  },
  "candidates": [
