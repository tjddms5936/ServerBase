{
  "plan_version": "v1",
  "status": "design_only_not_trained",
  "scope": "시계열 입력 계약과 다음 LSTM 학습의 제한된 후보 설계다. 이번 단계에서는 모델을 학습하지 않는다.",
  "sequence_dataset_id": "operational_message_sequence_v1",
